      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista vacía sin candidatos\",()=>pm.expect(pm.response.json()).to.deep.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Crear solicitud de cuatro asientos",
      "request": {
        "method": "POST",
        "header": [

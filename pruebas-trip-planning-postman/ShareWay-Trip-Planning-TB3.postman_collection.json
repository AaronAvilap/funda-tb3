          }
        ],
        "url": "{{baseUrl}}/api/v1/trip-requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passengerId\": 25,\n  \"originLabel\": \"UPC Monterrico\",\n  \"destinationLabel\": \"Chorrillos\",\n  \"operationZone\": \"{{zone}}\",\n  \"originLat\": -12.1048,\n  \"originLng\": -76.9632,\n  \"destinationLat\": -12.1721,\n  \"destinationLng\": -77.0164,\n  \"travelDate\": \"2026-11-10\",\n  \"earliestDeparture\": \"07:30:00\",\n  \"latestDeparture\": \"08:30:00\",\n  \"seatsRequested\": 4\n}",
